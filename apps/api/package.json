{
  "name": "@uncertaintycat/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --config wrangler.no-ai.jsonc --outdir dist",
    "build:production": "wrangler deploy --dry-run --containers-rollout=none --config wrangler.production.jsonc --outdir dist-production",
    "deploy:production": "wrangler deploy --config wrangler.generated.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.48",
    "@cloudflare/sandbox": "^0.12.10",
    "@hono/zod-validator": "^0.9.1",
    "@uncertaintycat/contracts": "0.2.0",
    "ai": "^7.0.114",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.2",
    "hono": "^4.13.9",
    "katex": "0.18.9",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/node": "^26.6.2",
    "miniflare": "5.20260910.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  }
}
