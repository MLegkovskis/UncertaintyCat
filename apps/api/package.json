{
  "name": "@uncertaintycat/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --config wrangler.no-ai.jsonc --outdir dist",
    "build:production": "wrangler deploy --dry-run --containers-rollout=none --config wrangler.production.jsonc --outdir dist-production",
    "deploy:production": "wrangler deploy --config wrangler.generated.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.7",
    "@hono/zod-validator": "^0.9.0",
    "@uncertaintycat/contracts": "0.2.0",
    "ai": "^7.0.77",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.9.0",
    "workers-ai-provider": "3.1.14",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
