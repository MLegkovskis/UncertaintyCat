{
  "name": "@uncertaintycat/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:full-stack": "playwright test --config playwright.full-stack.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@tanstack/react-query": "^5.85.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@uncertaintycat/contracts": "0.2.0",
    "better-auth": "^1.7.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
