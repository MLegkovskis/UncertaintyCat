{
  "name": "uncertaintycat-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:production": "npm run build --workspace @uncertaintycat/web && npm run build:production --workspace @uncertaintycat/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ts": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @uncertaintycat/web",
    "test:e2e:full-stack": "npm run test:e2e:full-stack --workspace @uncertaintycat/web",
    "test:e2e:production": "npm run test:e2e:production --workspace @uncertaintycat/web",
    "test:py": "uv run pytest",
    "test": "npm run test:ts && npm run test:py",
    "lint:py": "uv run ruff check uncertaintycat_core services tests",
    "typecheck:py": "uv run mypy uncertaintycat_core services",
    "format:py": "uv run ruff format uncertaintycat_core services tests",
    "generate:examples": "uv run python scripts/generate_example_catalog.py",
    "check:examples": "uv run python scripts/generate_example_catalog.py --check",
    "check:scientific-change": "uv run python scripts/check_scientific_change.py --run-declared-tests"
  },
  "engines": {
    "node": ">=22.0"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
